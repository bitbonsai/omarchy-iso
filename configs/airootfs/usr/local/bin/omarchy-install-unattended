#!/bin/bash
#
# omarchy-install-unattended: the Server install a launcher runs once the owner
# has confirmed erasure (omarchy-server-launcher's CONTRACT.md). Input:
#
#   DISK                 the disk under /dev, such as nvme0n1
#   SERVER_HOSTNAME      the server's name (bash overwrites an inherited HOSTNAME)
#   USERNAME             its owner
#   AUTHORIZED_KEY       the owner's public key(s), one per line
#   ENCRYPT              yes or no; with yes, the passphrase is stdin's first line
#   HOST_KEYS_OUT        a directory for the installed system's host public keys
#   TAILSCALE_STATE_DIR  optional: tailscaled state for the installed system
#
# It installs through the configurator's own answers and the orchestrator, the
# same path as the console, and logs to /run/omarchy-launch/install.log. It
# does not reboot: the launcher's agent does, once it has the host keys.

set -euo pipefail

log=/run/omarchy-launch/install.log
mkdir -p "${log%/*}"
exec >>"$log" 2>&1

for name in DISK SERVER_HOSTNAME USERNAME AUTHORIZED_KEY ENCRYPT HOST_KEYS_OUT; do
  [[ -n ${!name:-} ]] || { echo "omarchy-install-unattended: $name is not set" >&2; exit 2; }
done
[[ $DISK =~ ^[A-Za-z0-9._-]+$ ]] || { echo "omarchy-install-unattended: DISK must name a device under /dev" >&2; exit 2; }
mkdir -p "$HOST_KEYS_OUT"

IFS= read -r passphrase || passphrase=""

# The environment .automated_script.sh gives the console's install.
export OMARCHY_MIRROR="$(cat /root/omarchy_mirror)"
[[ ! -f /root/omarchy_iso_ref ]] || export OMARCHY_ISO_REF="$(cat /root/omarchy_iso_ref)"
if [[ -f /usr/share/omarchy-iso/package-targets ]]; then
  # shellcheck disable=SC1091
  source /usr/share/omarchy-iso/package-targets
  export OMARCHY_RUNTIME_PACKAGE OMARCHY_SETTINGS_PACKAGE OMARCHY_NVIM_PACKAGE
fi
export OMARCHY_PATH=/usr/share/omarchy OMARCHY_INSTALL=/usr/share/omarchy/install
export OMARCHY_INSTALL_LOG_FILE=$log OMARCHY_UI_INTERACTIVE=no

cd /root
rm -f user_configuration.json user_credentials.json user_encrypt_installation.txt authorized_keys tailscale_authkey defer-provisioning
printf '%s\n' "$passphrase" |
  OMARCHY_SERVER_HOSTNAME=$SERVER_HOSTNAME OMARCHY_SERVER_USERNAME=$USERNAME \
  OMARCHY_SERVER_KEYS=$AUTHORIZED_KEY OMARCHY_SERVER_DISK=/dev/$DISK OMARCHY_SERVER_ENCRYPT=$ENCRYPT \
  ./configurator --unattended
unset passphrase

OMARCHY_INSTALL_HOST_KEYS_OUT=$HOST_KEYS_OUT OMARCHY_INSTALL_TAILSCALE_STATE_DIR=${TAILSCALE_STATE_DIR:-} \
  /usr/local/bin/omarchy-iso-install \
    --config /root/user_configuration.json \
    --creds /root/user_credentials.json \
    --encrypt-file /root/user_encrypt_installation.txt \
    --authorized-keys-file /root/authorized_keys
